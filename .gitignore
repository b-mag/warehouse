## A streamlined .gitignore for modern .NET projects
## including temporary files, build results, and
## files generated by popular .NET tools. If you are
## developing with Visual Studio, the VS .gitignore
## https://github.com/github/gitignore/blob/main/VisualStudio.gitignore
## has more thorough IDE-specific entries.
##
## Get latest from https://github.com/github/gitignore/blob/main/Dotnet.gitignore

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# NuGet Packages
*.nupkg
# NuGet Symbol Packages
*.snupkg

# dotenv environment variables file
.env

# Others
~$*
*~
CodeCoverage/

# MSBuild Binary and Structured Log
*.binlog

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUnit
*.VisualState.xml
TestResult.xml
nunit-*.xml

# ---------------------------------------------------------------------------
# Forge-specific ignores (added for initial commit)
# ---------------------------------------------------------------------------

# IDE / editor user-specific files
.vs/
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.user
*.suo
*.userosscache
*.sln.docstates
*.DotSettings.user

# .NET user secrets / local config (never commit secrets)
secrets.json
appsettings.*.Local.json
appsettings.Development.local.json
*.pfx
*.p12

# xUnit / VSTest results and coverage
[Tt]est[Rr]esults/
*.trx
*.coverage
*.coverofdictionary
coverage.*.json
coverage.cobertura.xml

# Embedded Postgres runtime data + extracted binaries (Npgsql embedded provider)
**/pgdata/
**/.embedded-postgres/
**/embedded-postgres*/
*.pgsql-data/

# ML.NET / ONNX model artifacts (Phase 2 - trained models are not source)
*.zip.mlnet
*.onnx
**/MLModels/*.zip
mlruns/

# Node / Next.js (Forge.Game web client)
node_modules/
.next/
out/
.turbo/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
*.tsbuildinfo

# .NET MAUI outputs (Forge.Game mobile monitor)
**/Platforms/**/bin/
**/Platforms/**/obj/

# Docker / local infra volumes
**/docker-data/
.docker/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Kiro spec-driven development files (local workflow, not part of the shipped solution)
.kiro/
**/.kiro/
*.kiro
.config.kiro

# Log files (build/test diagnostics, ad-hoc run logs)
*.log

# Ad-hoc test result directories (dotnet test --results-directory)
TestResults/
TR2/
TR3/
