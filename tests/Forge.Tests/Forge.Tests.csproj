<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="CsCheck" Version="4.8.0" />
    <PackageReference Include="NetArchTest.Rules" Version="1.3.2" />
    <!--
      Test-only EF Core in-memory provider (task 28.2): exercises the repositories' Add/Update/query/
      SaveChanges round-trips without a live Postgres (the live-Postgres migration integration test is
      the optional task 28.3). Pinned to the same 10.0.11 EF Core release as the runtime packages.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.11" />
  </ItemGroup>

  <!--
    ASP.NET Core shared framework: gives the Api-hub tests (task 33.1) access to the SignalR server
    types (Hub, IHubContext, IClientProxy) without a running server, matching the Forge.Api Web SDK.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Forge.Api\Forge.Api.csproj" />
    <ProjectReference Include="..\..\src\Forge.Domain\Forge.Domain.csproj" />
    <ProjectReference Include="..\..\src\Forge.Application\Forge.Application.csproj" />
    <ProjectReference Include="..\..\src\Forge.Infrastructure\Forge.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Forge.Simulation\Forge.Simulation.csproj" />
    <ProjectReference Include="..\..\src\Forge.Contracts\Forge.Contracts.csproj" />
  </ItemGroup>

</Project>
